  "bindings": {
    "mute_toggle": ["__sendkeys__", "volume_mute"],
    "screenshot": ["__sendkeys__", "win+shift+s"],
    "lock_screen": ["rundll32.exe", "user32.dll,LockWorkStation"],
    "show_desktop": ["__sendkeys__", "win+d"],
    "task_view": ["__sendkeys__", "win+tab"],
    "clipboard_history": ["__sendkeys__", "win+v"],
    "open_spotify": ["cmd.exe", "/c", "start", "spotify:"],
    "notify_test": ["powershell.exe", "-NoProfile", "-EncodedCommand", ""],
    "mic_toggle:a": ["nircmd.exe", "mutesysvolume", "0", "default_record"],
    "mic_toggle:b": ["nircmd.exe", "mutesysvolume", "1", "default_record"],
    "app_browser": ["cmd.exe", "/c", "start", "https://google.com"],
    "app_code": ["code.cmd"],
    "app_discord": ["cmd.exe", "/c", "start", "discord:"],
    "app_steam": ["cmd.exe", "/c", "start", "steam:"],
    "app_explorer": ["explorer.exe"],
    "app_terminal": ["wt.exe"],
    "app_notepad": ["notepad.exe"],
    "app_calc": ["calc.exe"],
    "app_taskmgr": ["taskmgr.exe"],
    "app_settings": ["cmd.exe", "/c", "start", "ms-settings:"]
  }
