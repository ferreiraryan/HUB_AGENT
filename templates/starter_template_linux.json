        "y": 0
      },
      {
        "type": "shortcut",
        "id": "app_files",
        "icon": "📁",
        "label": "Arquivos",
        "width": 2,
        "height": 1,
        "x": 0,
        "y": 1
      },
      {
        "type": "shortcut",
        "id": "app_btop",
        "icon": "📊",
        "label": "Btop Monitor",
        "width": 2,
        "height": 1,
        "x": 2,
        "y": 1
      },
      {
        "type": "shortcut",
        "id": "app_calc",
        "icon": "🧮",
        "label": "Calculadora",
