      },
      {
        "type": "shortcut",
        "id": "hypr_split",
        "icon": "↕️",
        "label": "Dividir Split",
        "width": 1,
        "height": 1,
        "x": 4,
        "y": 1
      },
      {
        "type": "shortcut",
        "id": "hypr_term",
