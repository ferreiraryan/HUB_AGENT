      {
        "type": "sound",
        "id": "sound_lula",
        "icon": "🔊",
        "label": "Presidente",
        "sound_id": "ah-lula-meu-presidente",
        "width": 1,
        "height": 1,
        "x": 3,
        "y": 0
      }
    ]
  },
  "bindings": {
    "mute_toggle": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
    "screenshot": ["__sendkeys__", "print"],
    "lock_screen": ["loginctl", "lock-session"],
    "open_spotify": ["spotify"],
    "mic_mute": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"],
    "notify_test": ["notify-send", "Hub Agent", "Teste de acionamento do tablet!"],
    "ws_1": ["hyprctl", "dispatch", "workspace", "1"],
    "ws_2": ["hyprctl", "dispatch", "workspace", "2"],
    "ws_3": ["hyprctl", "dispatch", "workspace", "3"],
    "ws_4": ["hyprctl", "dispatch", "workspace", "4"],
    "ws_5": ["hyprctl", "dispatch", "workspace", "5"],
    "hypr_close": ["hyprctl", "dispatch", "killactive"],
    "hypr_float": ["hyprctl", "dispatch", "togglefloating"],
    "hypr_full": ["hyprctl", "dispatch", "fullscreen"],
    "hypr_pin": ["hyprctl", "dispatch", "pin"],
    "hypr_split": ["hyprctl", "dispatch", "togglesplit"],
    "hypr_term": ["kitty"],
    "app_firefox": ["firefox"],
    "app_nvim": ["kitty", "-e", "nvim"],
    "app_code": ["code"],
    "app_discord": ["discord"],
    "app_steam": ["steam"],
    "app_files": ["xdg-open", "/home/ryck"],
    "app_btop": ["kitty", "-e", "btop"],
    "app_calc": ["galculator"]
  }
}
