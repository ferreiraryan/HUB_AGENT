        "height": 1,
        "x": 1,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "app_nvim",
        "icon": "📝",
        "label": "Neovim",
        "width": 1,
        "height": 1,
        "x": 2,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "app_code",
        "icon": "💻",
        "label": "VS Code",
        "width": 1,
        "height": 1,
        "x": 3,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "app_discord",
        "icon": "💬",
        "label": "Discord",
        "width": 1,
        "height": 1,
        "x": 4,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "app_steam",
        "icon": "🎮",
