        "height": 1,
        "x": 4,
        "y": 1
      }
    ],
    "soundpad": [
      {
        "type": "back",
        "id": "back_soundpad",
        "icon": "⬅️",
        "label": "Voltar",
        "width": 1,
        "height": 1,
        "x": 0,
        "y": 0,
        "target": "home"
      },
      {
        "type": "slider",
        "id": "soundpad_vol",
        "icon": "🎚️",
        "label": "Volume Som",
