{
  "deviceName": "archlinux",
  "theme": {
    "bgColor": "#11111b",
    "cardColor": "#1e1e2e",
    "accentColor": "#cba6f7"
  },
  "pages": {
    "home": [
      {
        "type": "slider",
        "id": "master_volume",
        "icon": "🔊",
        "label": "Volume Principal",
        "width": 1,
        "height": 2,
        "x": 0,
        "y": 0,
        "source": { "kind": "master_volume" }
      },
      {
        "type": "slider",
        "id": "controle_brilho",
        "icon": "☀️",
        "label": "Brilho",
        "width": 1,
        "height": 2,
        "x": 1,
        "y": 0,
        "source": { "kind": "brightness" }
      },
      {
        "type": "stat",
        "id": "stat_cpu",
        "icon": "⚡",
        "label": "CPU",
        "width": 1,
        "height": 1,
        "x": 2,
        "y": 0,
        "source": { "kind": "cpu", "field": "load", "unit": "%" }
      },
      {
        "type": "stat",
        "id": "stat_ram",
        "icon": "🧠",
        "label": "RAM",
        "width": 1,
        "height": 1,
        "x": 3,
        "y": 0,
        "source": { "kind": "ram", "field": "percent", "unit": "%" }
      },
      {
        "type": "folder",
        "id": "folder_audio",
        "icon": "🎵",
        "label": "Áudio & Mídia",
        "width": 1,
        "height": 1,
        "x": 4,
        "y": 0,
        "target": "audio"
      },
      {
        "type": "folder",
        "id": "folder_hypr",
        "icon": "🖥️",
        "label": "Hyprland",
        "width": 1,
        "height": 1,
        "x": 5,
        "y": 0,
        "target": "hyprland"
      },
      {
        "type": "stat",
        "id": "stat_temp",
        "icon": "🌡️",
        "label": "Temp CPU",
        "width": 1,
        "height": 1,
        "x": 2,
        "y": 1,
        "source": { "kind": "cpu", "field": "temp", "unit": "°C" }
      },
      {
        "type": "stat",
        "id": "stat_disk",
        "icon": "💾",
        "label": "Disco /",
        "width": 1,
        "height": 1,
        "x": 3,
        "y": 1,
        "source": { "kind": "disk", "field": "percent", "unit": "%" }
      },
      {
        "type": "folder",
        "id": "folder_apps",
        "icon": "🚀",
        "label": "Aplicativos",
        "width": 1,
        "height": 1,
        "x": 4,
        "y": 1,
        "target": "apps"
      },
      {
        "type": "folder",
        "id": "folder_soundpad",
        "icon": "🔊",
        "label": "Sound Pad",
        "width": 1,
        "height": 1,
        "x": 5,
        "y": 1,
        "target": "soundpad"
      },
      {
        "type": "shortcut",
        "id": "mute_toggle",
        "icon": "🔇",
        "label": "Mudo",
        "width": 1,
        "height": 1,
        "x": 0,
        "y": 2
      },
      {
        "type": "shortcut",
        "id": "screenshot",
        "icon": "📸",
        "label": "Print",
        "width": 1,
        "height": 1,
        "x": 1,
        "y": 2
      },
      {
        "type": "shortcut",
        "id": "prev",
        "icon": "⏮️",
        "label": "Anterior",
        "width": 1,
        "height": 1,
        "x": 2,
        "y": 2
      },
      {
        "type": "shortcut",
        "id": "play_pause",
        "icon": "⏯️",
        "label": "Play/Pause",
        "width": 1,
        "height": 1,
        "x": 3,
        "y": 2
      },
      {
        "type": "shortcut",
        "id": "next",
        "icon": "⏭️",
        "label": "Próximo",
        "width": 1,
        "height": 1,
        "x": 4,
        "y": 2
      },
      {
        "type": "shortcut",
        "id": "lock_screen",
        "icon": "🔒",
        "label": "Bloquear",
        "width": 1,
        "height": 1,
        "x": 5,
        "y": 2
      }
    ],
    "audio": [
      {
        "type": "back",
        "id": "back_audio",
        "icon": "⬅️",
        "label": "Voltar",
        "width": 1,
        "height": 1,
        "x": 0,
        "y": 0,
        "target": "home"
      },
      {
        "type": "shortcut",
        "id": "prev",
        "icon": "⏮️",
        "label": "Anterior",
        "width": 1,
        "height": 1,
        "x": 1,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "play_pause",
        "icon": "⏯️",
        "label": "Play/Pause",
        "width": 1,
        "height": 1,
        "x": 2,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "next",
        "icon": "⏭️",
        "label": "Próximo",
        "width": 1,
        "height": 1,
        "x": 3,
        "y": 0
      },
      {
        "type": "slider",
        "id": "vol_spotify",
        "icon": "🎵",
        "label": "Vol. Spotify",
        "width": 2,
        "height": 1,
        "x": 4,
        "y": 0,
        "source": { "kind": "app_volume", "match": "Spotify" }
      },
      {
        "type": "slider",
        "id": "vol_firefox",
        "icon": "🦊",
        "label": "Vol. Firefox",
        "width": 2,
        "height": 1,
        "x": 0,
        "y": 1,
        "source": { "kind": "app_volume", "match": "Firefox" }
      },
      {
        "type": "slider",
        "id": "vol_discord",
        "icon": "💬",
        "label": "Vol. Discord",
        "width": 2,
        "height": 1,
        "x": 2,
        "y": 1,
        "source": { "kind": "app_volume", "match": "Discord" }
      },
      {
        "type": "slider",
        "id": "vol_soundpad",
        "icon": "🎚️",
        "label": "Vol. Sound Pad",
        "width": 2,
        "height": 1,
        "x": 4,
        "y": 1,
        "source": { "kind": "sound_volume" }
      },
      {
        "type": "shortcut",
        "id": "open_spotify",
        "icon": "🟢",
        "label": "Abrir Spotify",
        "width": 2,
        "height": 1,
        "x": 0,
        "y": 2
      },
      {
        "type": "shortcut",
        "id": "mic_mute",
        "icon": "🎙️",
        "label": "Mic Mute",
        "width": 2,
        "height": 1,
        "x": 2,
        "y": 2
      },
      {
        "type": "shortcut",
        "id": "notify_test",
        "icon": "🔔",
        "label": "Notificação",
        "width": 2,
        "height": 1,
        "x": 4,
        "y": 2
      }
    ],
    "hyprland": [
      {
        "type": "back",
        "id": "back_hypr",
        "icon": "⬅️",
        "label": "Voltar",
        "width": 1,
        "height": 1,
        "x": 0,
        "y": 0,
        "target": "home"
      },
      {
        "type": "shortcut",
        "id": "ws_1",
        "icon": "1️⃣",
        "label": "Workspace 1",
        "width": 1,
        "height": 1,
        "x": 1,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "ws_2",
        "icon": "2️⃣",
        "label": "Workspace 2",
        "width": 1,
        "height": 1,
        "x": 2,
        "y": 0
      },
      {
        "type": "shortcut",
        "id": "ws_3",
        "icon": "3️⃣",
        "label": "Workspace 3",
        "width": 1,
        "height": 1,
