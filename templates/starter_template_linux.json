        "icon": "⬅️",
        "label": "Voltar",
        "width": 1,
        "height": 1,
        "x": 0,
        "y": 0,
        "target": "home"
      },
      {
        "type": "shortcut",
        "id": "app_firefox",
        "icon": "🦊",
        "label": "Firefox",
